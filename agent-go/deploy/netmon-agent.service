[Unit]
Description=NetMon Insight Agent - Network & Server Monitoring
Documentation=https://github.com/muzzf16/NetMon_Insight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netmon
Group=netmon
ExecStart=/usr/local/bin/netmon-agent -config /etc/netmon-agent/config.yaml
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/proc /sys
ReadWritePaths=/var/log/netmon

# Required for ICMP ping
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netmon-agent

[Install]
WantedBy=multi-user.target
